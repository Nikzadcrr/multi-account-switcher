        <svg class="theme-icon ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <span class="lbl-dark">Dark</span><span class="lbl-light">Light</span>
    </button>
    
    <script>
        // page data
        const templateData = {
            fileId: "XxLUrA9kpkN",
            fileName: "Instant Mail 8.6.0.apk",
            fileSize: "52.28 MB",
            fileType: "Android APK",
            mimeType: "application/vnd.android.package-archive",
            uploadTime: "26 minutes ago",
            expiryTime: 1793509751918,
            downloadUrl: "https://tempfile.org/XxLUrA9kpkN/download",
            countdownSeconds: 5,
            showAds: true,
            virusScan: true
        };

        let countdownTimer;
        let expiryUpdateTimer;
        let retryTimer;

        function getFileIcon(mimeType) {
            if (mimeType.startsWith('image/')) return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg>️';
            if (mimeType.startsWith('video/')) return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7" /><rect x="1" y="5" width="15" height="14" rx="2" ry="2" /></svg>';
            if (mimeType.startsWith('audio/')) return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="18" cy="16" r="3" /></svg>';
            if (mimeType.includes('pdf')) return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M4 4h16v16H6.5A2.5 2.5 0 0 0 4 22z" /></svg>';
            if (mimeType.includes('zip') || mimeType.includes('rar')) return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.73z" /><path d="M3.3 7.5L12 12l8.7-4.5" /><path d="M12 22V12" /></svg>';
            if (mimeType.includes('word')) return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" /></svg>';
            if (mimeType.includes('excel')) return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="12" width="4" height="8" /><rect x="10" y="9" width="4" height="11" /><rect x="17" y="5" width="4" height="15" /></svg>';
            return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" /><polyline points="14 2 14 8 20 8" /></svg>';
        }

        function getTimeRemaining(expiryTime) {
            const now = Date.now();
            const difference = expiryTime - now;

            if (difference <= 0) {
                return { text: 'Expired', isExpired: true, className: 'expired' };
            }

            const seconds = Math.floor(difference / 1000);
            const minutes = Math.floor(seconds / 60);
            const hours = Math.floor(minutes / 60);
            const days = Math.floor(hours / 24);

            let text, className;

            if (days > 0) {
                const remainingHours = hours % 24;
                text = `${days}d ${remainingHours}h`;
                className = days > 1 ? 'expires-safe' : 'expires-soon';
            } else if (hours > 0) {
                const remainingMinutes = minutes % 60;
                text = `${hours}h ${remainingMinutes}m`;
                className = hours > 2 ? 'expires-soon' : 'expires-critical';
            } else if (minutes > 0) {
                text = `${minutes}m`;
                className = 'expires-critical';
            } else {
                text = `${seconds}s`;
                className = 'expires-critical';
            }

            return { text, isExpired: false, className };
        }

        function updateExpiryDisplay() {
            const expiryElement = document.getElementById('expiryTime');
            const timeInfo = getTimeRemaining(templateData.expiryTime);
            
            expiryElement.textContent = timeInfo.text;
            expiryElement.className = `live-countdown ${timeInfo.className}`;
            
            if (timeInfo.isExpired) {
                expiryElement.textContent = 'File Expired';
                document.getElementById('downloadBtn').disabled = true;
            }
        }

        function startVirusScan() {
            const securitySection = document.getElementById('securitySection');
            if (!securitySection) return;
            const securityTitle = document.getElementById('securityTitle');
            const securityIcon = document.getElementById('securityIcon');
            const securityChecks = document.getElementById('securityChecks');
            const scanProgressBar = document.getElementById('scanProgressBar');
            const scanningText = document.getElementById('scanningText');
            
            securitySection.classList.add('scanning');
            securityTitle.classList.add('scanning');
            
            const scanSteps = [
                { progress: 25, text: "Analyzing file signature...", duration: 800 },
                { progress: 50, text: "Deep scanning for threats...", duration: 1200 },
                { progress: 75, text: "Checking against virus database...", duration: 900 },
                { progress: 100, text: "Finalizing security verification...", duration: 600 }
            ];
            
            let currentStep = 0;
            
            function runScanStep() {
                if (currentStep < scanSteps.length) {
                    const step = scanSteps[currentStep];
                    scanProgressBar.style.width = step.progress + '%';
                    scanningText.textContent = step.text;
                    
                    setTimeout(() => {
                        currentStep++;
                        runScanStep();
                    }, step.duration);
                } else {
                    // Scan completed - show verified status
                    setTimeout(() => {
                        securitySection.classList.remove('scanning');
                        securityTitle.classList.remove('scanning');
                        securityIcon.textContent = '<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>️';
                        securityTitle.innerHTML = '<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>&nbsp;Security & Safety Verified';
                        // securityTitle.style.color = '#166534';
                        
                        // Update all checks to completed
                        const checks = document.querySelectorAll('.security-check');
                        const completedChecks = [
                            { icon: '✓', text: 'Virus scan completed' },
                            { icon: '✓', text: 'Content policy compliant' },
                            { icon: '✓', text: 'Safe file verified' },
                            { icon: '✓', text: 'Encrypted transmission' }
                        ];
                        
                        checks.forEach((check, index) => {
                            check.classList.remove('scanning');
                            // check.style.color = '#166534';
                            check.innerHTML = `<span class="check-icon">${completedChecks[index].icon}</span>${completedChecks[index].text}`;
                        });
                        
                        // Hide progress bar and scanning text
                        document.querySelector('.scan-progress').style.display = 'none';
                        scanningText.style.display = 'none';
                    }, 500);
                }
            }
            
            runScanStep();
        }

        function startCountdown() {
            let timeLeft = templateData.countdownSeconds;
            const progressBar = document.getElementById('progressBar');
            const countdownDisplay = document.getElementById('countdownDisplay');
            const downloadBtn = document.getElementById('downloadBtn');
            const downloadText = document.getElementById('downloadText');
            
            countdownTimer = setInterval(() => {
                timeLeft--;
                const progress = ((templateData.countdownSeconds - timeLeft) / templateData.countdownSeconds) * 100;
                progressBar.style.width = progress + '%';
                countdownDisplay.textContent = timeLeft + 's';
                
                if (timeLeft <= 0) {
                    clearInterval(countdownTimer);
                    document.getElementById('countdownSection').style.display = 'none';
                    downloadBtn.disabled = false;
                    downloadText.innerHTML = ' Download File';
                    
                    // Show image preview if it exists
                    const imagePreview = document.getElementById('imagePreview');
                    if (imagePreview) {
                        imagePreview.style.display = 'block';
                    }
                }
            }, 1000);
        }

        function handleDownload() {
            const downloadBtn = document.getElementById('downloadBtn');
            const downloadText = document.getElementById('downloadText');
            const downloadIcon = document.getElementById('downloadIcon');
            const retryBtn = document.getElementById('retryBtn');
            
            // Update button appearance
            downloadBtn.classList.add('download-started');
            downloadBtn.disabled = true;
            downloadText.textContent = 'Download Started';
            downloadIcon.innerHTML = '<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>';
            downloadIcon.classList.add('loading');
            
            // Start the actual download
            window.location.href = templateData.downloadUrl;
            
            // Show retry button after 7 seconds
            retryTimer = setTimeout(() => {
                retryBtn.style.display = 'block';
                showRetryStatus();
            }, 7000);
        }

        // Next to the Retry button, show the live "File downloads" badge. It is only requested now,
        // so it is current, and it quietly removes itself if the status page cannot be reached.
        function showRetryStatus() {
            const box = document.getElementById('retryStatus');
            if (!box) return;
            const img = box.querySelector('img');
            img.onload = function () { box.hidden = false; };
            img.onerror = function () { box.remove(); };
            img.src = img.getAttribute('data-src');
        }

        function retryDownload() {
            // Simply refresh the page to restart the download process
            window.location.reload();
        }
        
        function initializePage() {
            // Update file icon if not already set by template
            const fileIconEl = document.getElementById('fileIcon');
            if (false || !fileIconEl.textContent.trim()) {
                fileIconEl.innerHTML = getFileIcon(templateData.mimeType);
            }
            
            // Set up download button
            document.getElementById('downloadBtn').onclick = handleDownload;
            
            // Update expiry time display
            updateExpiryDisplay();
            expiryUpdateTimer = setInterval(updateExpiryDisplay, 1000);
            
            // Start countdown
            startCountdown();
            
            // Start virus scan
            if (document.getElementById('securitySection')) {
                    startVirusScan();
                }
        }

        function copyLink() {
            const linkInput = document.getElementById('directLink');
            linkInput.select();
            document.execCommand('copy');
            
            const copyBtn = document.querySelector('.copy-btn');
            const originalText = copyBtn.textContent;
            copyBtn.textContent = 'Copied!';
            copyBtn.style.background = '#22c55e';
            
            setTimeout(() => {
                copyBtn.textContent = originalText;
            }, 2000);
        }

        // Initialize the page when DOM is loaded
        document.addEventListener('DOMContentLoaded', initializePage);

        // Clean up timers when page is unloaded
        window.addEventListener('beforeunload', () => {
            if (countdownTimer) clearInterval(countdownTimer);
            if (expiryUpdateTimer) clearInterval(expiryUpdateTimer);
            if (retryTimer) clearTimeout(retryTimer);
        });
    </script>
    <script defer src="/js/pwa.js?ver=2.0.0"></script>
    <script defer src="/js/support.js?ver=1.0.0"></script>
</body>
</html>